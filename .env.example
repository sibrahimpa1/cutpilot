# ─────────────────────────────────────────────────────────────────────────────
# CutPilot configuration. Copy to .env and fill in what you have.
# Every key is optional: without keys the app runs fully offline
# (heuristic planner, macOS `say` / espeak-ng voice, local whisper.cpp,
#  generated scene art, synthesised music).
# ─────────────────────────────────────────────────────────────────────────────

# Claude plans the edit: picks moments, writes scripts, turns revision requests
# into edit operations. https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenRouter: one key for everything (https://openrouter.ai/keys).
#  - Claude planner (when ANTHROPIC_API_KEY is not set)
#  - photoreal AI video per shot, with native sound (Veo 3.1 Fast by default, ~$0.10/s at 720p)
#  - AI images (first frames, consistent subject across shots)
#  - natural voice-over (gpt-audio) and composed music (Lyria)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# OPENROUTER_VIDEO_MODEL=google/veo-3.1-fast     # or google/veo-3.1, kwaivgi/kling-v3.0-pro, alibaba/wan-3.0 …
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# OPENROUTER_TTS_MODEL=openai/gpt-audio
# OPENROUTER_TTS_VOICE=onyx                       # alloy, echo, fable, nova, shimmer …

# OpenAI: voiceover (gpt-4o-mini-tts), transcription fallback (whisper-1),
# image generation (gpt-image-1).
OPENAI_API_KEY=
# OPENAI_TTS_VOICE=alloy

# ElevenLabs voiceover (preferred over OpenAI TTS when set).
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Pexels stock footage and photos per scene (free key: https://www.pexels.com/api/).
PEXELS_API_KEY=

# Force a provider instead of the automatic choice (first available wins):
# LLM_PROVIDER=claude|openrouter|heuristic
# TTS_PROVIDER=elevenlabs|openai|openrouter|say|espeak-ng|silent
# STT_PROVIDER=whisper-cpp|openai|none
# VISUALS_PROVIDER=openrouter-video|pexels|openai|openrouter-image|placeholder

# Local tools
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# WHISPER_CPP_BIN=whisper-cli
# WHISPER_MODEL=./data/models/ggml-base.en.bin
# SAY_VOICE=Samantha
# CAPTION_FONT=Arial

# Where projects, renders and the SQLite database live.
# DATA_DIR=./data
